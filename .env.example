# ── OpenRouter (разбор инструкций ИИ) ──────────────────────────────
# Ключ OpenRouter. Если не задан — приложение работает в ОФФЛАЙН-режиме
# (детерминированный парсер-заглушка), ИИ не вызывается.
OPENROUTER_API_KEY=

# Модель OpenRouter для разбора инструкций. По умолчанию — бесплатная.
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Необязательные заголовки для рейтинга на openrouter.ai
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_TITLE=genOferta

# Принудительно оффлайн-режим (без обращения к ИИ), даже если ключ задан.
# Значения: "1" / "true" — включить. Пусто — авто (ИИ если есть ключ).
GENOFERTA_OFFLINE=
